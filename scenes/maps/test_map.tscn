[sub_resource type="GDScript" id="GDScript_72sho"]
script/source = "extends Polygon2D

func _ready() -> void:
	print(\"✅ Zone de spawn créée : \", name)
	
	# Ajouter au groupe
	add_to_group(\"spawn_zones\")
	
	# Couleur verte semi-transparente
	modulate = Color(0, 1, 0, 0.3)
	
	# Masquer en jeu (visible seulement en éditeur)
	if not Engine.is_editor_hint():
		visible = false

func get_random_point_inside() -> Vector2:
	# Si le polygone est vide, retourner la position du node
	if polygon.size() < 3:
		print(\"⚠️ Polygone vide, utilisation de la position par défaut\")
		return global_position
	
	# Calculer les limites du polygone (bounding box)
	var min_x = INF
	var max_x = -INF
	var min_y = INF
	var max_y = -INF
	
	for point in polygon:
		var global_point = to_global(point)
		min_x = min(min_x, global_point.x)
		max_x = max(max_x, global_point.x)
		min_y = min(min_y, global_point.y)
		max_y = max(max_y, global_point.y)
	
	# Générer des points aléatoires jusqu'à en trouver un dans le polygone
	var max_attempts = 100
	for i in range(max_attempts):
		var random_point = Vector2(
			randf_range(min_x, max_x),
			randf_range(min_y, max_y)
		)
		
		# Vérifier si le point est dans le polygone
		if Geometry2D.is_point_in_polygon(to_local(random_point), polygon):
			return random_point
	
	# Fallback : retourner le centre du polygone
	print(\"⚠️ Aucun point trouvé dans le polygone après \", max_attempts, \" tentatives\")
	return global_position
"

